# Runtime
NODE_ENV=development
APP_ENV=local
PORT=3000
API_PORT=4000
API_HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# Restricts provider routing and financial calls to one connector environment.
# Allowed: DEVELOPMENT, SANDBOX, STAGING, PRODUCTION
PROVIDER_RUNTIME_ENV=PRODUCTION

# Database / cache
DATABASE_URL=postgresql://nolivendaz:nolivendaz@localhost:5432/nolivendaz_bo
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379

# Security
# Use secret-manager references in deployed environments. Do not commit real values.
JWT_SECRET=replace-with-at-least-32-characters-for-local-development
SESSION_SECRET=replace-in-local-only
FIELD_ENCRYPTION_KEY=replace-in-local-only

# NOLI Native Vending
NATIVE_VENDING_BASE_URL=
NATIVE_VENDING_CLIENT_ID=
NATIVE_VENDING_CLIENT_SECRET=
NATIVE_VENDING_WEBHOOK_SECRET=

# CPay / ChargeNow
CPAY_BASE_URL=
CPAY_CLIENT_ID=
CPAY_CLIENT_SECRET=
CPAY_WEBHOOK_SECRET=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Notifications
SMTP_URL=
SMS_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=
