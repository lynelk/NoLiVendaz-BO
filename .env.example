# Runtime
NODE_ENV=development
APP_ENV=local
PORT=3000
API_PORT=4000
API_HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
BACKOFFICE_API_URL=http://localhost:4000
# LOCAL DEVELOPMENT ONLY. Never set in production.
BACKOFFICE_DEV_BEARER_TOKEN=
# Provider execution environment: DEVELOPMENT, SANDBOX, STAGING, PRODUCTION
PROVIDER_RUNTIME_ENV=PRODUCTION

# Operator authentication (OIDC Authorization Code + PKCE)
# The web app validates the OIDC callback/userinfo then exchanges identity for an internal short-lived API JWT.
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile
OIDC_TENANT_CODE=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# Shared only between backoffice-web and backoffice-api. At least 32 random characters.
AUTH_EXCHANGE_SECRET=replace-with-a-separate-32-character-random-secret

# Automated recovery worker
RECOVERY_WORKER_INTERVAL_MS=300000
RECOVERY_WORKER_BATCH_SIZE=25

# Database / cache
DATABASE_URL=postgresql://nolivendaz:nolivendaz@localhost:5432/nolivendaz_bo
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=replace-with-at-least-32-characters-for-local-development
SESSION_SECRET=replace-in-local-only
FIELD_ENCRYPTION_KEY=replace-in-local-only

# NOLI Native Vending
NATIVE_VENDING_BASE_URL=
NATIVE_VENDING_CLIENT_ID=
NATIVE_VENDING_CLIENT_SECRET=
NATIVE_VENDING_WEBHOOK_SECRET=

# CPay / ChargeNow
CPAY_BASE_URL=
CPAY_CLIENT_ID=
CPAY_CLIENT_SECRET=
CPAY_WEBHOOK_SECRET=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
# Optional bearer protection for /metrics. Recommended outside a private service network.
METRICS_TOKEN=

# Alerts / notifications
SMTP_URL=
SMS_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=
ALERT_WEBHOOK_URL=

# Backup / DR
BACKUP_S3_URI=
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
