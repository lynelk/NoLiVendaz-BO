# Runtime
NODE_ENV=development
APP_ENV=local
PORT=3000
API_PORT=4000
API_HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
BACKOFFICE_API_URL=http://localhost:4000
BACKOFFICE_DEV_BEARER_TOKEN=
PROVIDER_RUNTIME_ENV=PRODUCTION

# Operator authentication (OIDC Authorization Code + PKCE)
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile
OIDC_TENANT_CODE=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
AUTH_EXCHANGE_SECRET=replace-with-a-separate-32-character-random-secret

# First administrator bootstrap. Use only with `pnpm bootstrap:admin`, then remove from runtime environments.
BOOTSTRAP_TENANT_CODE=NOLI
BOOTSTRAP_TENANT_NAME=NOLI Vendaz
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Background workers
RECOVERY_WORKER_INTERVAL_MS=300000
RECOVERY_WORKER_BATCH_SIZE=25
OPERATIONS_WORKER_INTERVAL_MS=120000

# Database / cache
DATABASE_URL=postgresql://nolivendaz:nolivendaz@localhost:5432/nolivendaz_bo
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_APPLICATION_NAME=nolivendaz-backoffice
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=replace-with-at-least-32-characters-for-local-development
SESSION_SECRET=replace-in-local-only
FIELD_ENCRYPTION_KEY=replace-in-local-only

# NOLI Native Vending
NATIVE_VENDING_BASE_URL=
NATIVE_VENDING_CLIENT_ID=
NATIVE_VENDING_CLIENT_SECRET=
NATIVE_VENDING_WEBHOOK_SECRET=

# CPay / ChargeNow
CPAY_BASE_URL=
CPAY_CLIENT_ID=
CPAY_CLIENT_SECRET=
CPAY_WEBHOOK_SECRET=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
METRICS_TOKEN=

# Alerts / notifications
SMTP_URL=
SMS_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=
ALERT_WEBHOOK_URL=

# Backup / DR
BACKUP_S3_URI=
BACKUP_RETENTION_DAYS=30
BACKUP_TMP_DIR=/tmp/nolivendaz-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
